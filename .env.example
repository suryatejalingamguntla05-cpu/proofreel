# ---------------------------------------------------------------------------
# CreatorProof AI - environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (publishable keys only; never expose service-role in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key is ONLY for server-side code. Keep it out of browser bundles.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# --- Optional AI (Gemini) for the AI Brief Builder ---
# Required ONLY to use AI-generated briefs. The builder works with a
# deterministic local template when this is absent or the API fails.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# --- Optional social connectors (YouTube, Instagram, Facebook) ---
# These drive the connector architecture. Manual metric entry works without them.
INSTAGRAM_CLIENT_ID=<your-instagram-oauth-client-id>
INSTAGRAM_CLIENT_SECRET=<your-instagram-oauth-client-secret>
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/social/callback
YOUTUBE_API_KEY=<your-youtube-data-api-key>
FACEBOOK_APP_ID=<your-facebook-app-id>
FACEBOOK_APP_SECRET=<your-facebook-app-secret>

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
