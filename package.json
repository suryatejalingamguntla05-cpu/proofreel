{
  "name": "proofreel",
  "version": "0.1.0",
  "private": true,
  "description": "Proofreel - an evidence-backed AI creator marketplace",
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db migrate",
    "db:seed": "node scripts/seed-database.js",
    "db:reset-local": "npm run db:reset && npm run db:seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.47.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "isbot": "^5.1.17",
    "lucide-react": "^0.475.0",
    "next": "14.2.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
